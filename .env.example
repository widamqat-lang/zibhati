# ============================================
# ذبيحتي - متغيرات البيئة
# ============================================

# Server Configuration
PORT=8080

# ============================================
# API Server
# ============================================

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Clerk Authentication
# Get these from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Session Secret (generate a random 32+ char string)
# Example: openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# ============================================
# Frontend (dheebti)
# ============================================

# Base path for the application
BASE_PATH=/

# Clerk Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API URL (point to your deployed API server)
# Leave empty to use same origin
VITE_API_URL=

# ============================================
# Firebase Configuration (ذبيحتي)
# ============================================
# Get these from Firebase Console: https://console.firebase.google.com

# Frontend Firebase Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side Firebase Admin Config
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
