# ============================================
# Frontend Environment Variables
# ============================================
# These variables will be auto-injected by Railway

# Server Configuration
PORT=8080

# Base path for the application (empty for root)
BASE_PATH=/

# Clerk Authentication (must match API server)
# Get this from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API URL (point to your API server)
VITE_API_URL=https://your-api-server.railway.app
